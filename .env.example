# =====================================================
# Ramganj Connect - Environment Variables (example)
# =====================================================
# Copy this file to .env and fill in real values.
# .env MUST stay out of version control (see .gitignore).
# Never commit real secrets. Rotate keys if leaked.
# =====================================================

# --- Supabase (https://supabase.com) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# --- Firebase Cloud Messaging (https://console.firebase.google.com) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=